# Continental eBike System / STM Display  (USB VID 0x2A8A)
#
#   Applikation : PID 0x0010, Produktstring "Continental eBike System "
#                 HID-Interface, Usage Page 0xFF00 (Vendor)
#   Bootloader  : Produktstring "CEBS Bootloader Mode" (USB-HID-IAP)
#
# Ohne diese Regel gehoeren die /dev/hidrawX-Geraete root und das Flash-Tool
# bekommt "Permission denied".
#
# Installation (einmalig):
#     sudo cp tools/99-continental-ebike.rules /etc/udev/rules.d/
#     sudo udevadm control --reload-rules && sudo udevadm trigger
#     # Geraet ab- und wieder anstecken
#
# Sicherer als MODE="0666" waere eine Gruppe, z. B.:
#     SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2a8a", MODE="0660", GROUP="plugdev"

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2a8a", MODE="0666"
SUBSYSTEM=="usb",    ATTR{idVendor}=="2a8a",  MODE="0666"
